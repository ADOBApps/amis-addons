{
  "amis_panel": 1,
  "title": "U-Net",
  "width": 600,
  "height": 740,
  "metadata": {
    "note": "Generated for the AMIS addon catalogue."
  },
  "root": {
    "type": "vbox",
    "children": [
      {
        "type": "scroll",
        "children": [
          {
            "type": "label",
            "name": "intro",
            "props": {
              "text": "PLACEHOLDER",
              "wrap": true
            }
          },
          {
            "type": "group",
            "props": {
              "title": "Data"
            },
            "children": [
              {
                "type": "dir",
                "name": "images_dir",
                "props": {
                  "label": "Images"
                }
              },
              {
                "type": "dir",
                "name": "masks_dir",
                "props": {
                  "label": "Masks"
                }
              },
              {
                "type": "button",
                "name": "scan",
                "props": {
                  "label": "Scan dataset"
                },
                "on_click": "on_scan_clicked"
              },
              {
                "type": "label",
                "name": "dataset_info",
                "props": {
                  "text": "No dataset scanned",
                  "wrap": true
                }
              }
            ]
          },
          {
            "type": "group",
            "props": {
              "title": "Model"
            },
            "children": [
              {
                "type": "spin",
                "name": "base_channels",
                "props": {
                  "label": "Base channels",
                  "value": 32,
                  "minimum": 8,
                  "maximum": 64,
                  "step": 8
                }
              },
              {
                "type": "spin",
                "name": "depth",
                "props": {
                  "label": "Depth",
                  "value": 4,
                  "minimum": 2,
                  "maximum": 5,
                  "step": 1
                }
              },
              {
                "type": "dspin",
                "name": "dropout",
                "props": {
                  "label": "Dropout",
                  "value": 0.0,
                  "minimum": 0.0,
                  "maximum": 0.8,
                  "step": 0.05,
                  "decimals": 2
                }
              },
              {
                "type": "button",
                "name": "inspect_model",
                "props": {
                  "label": "Count parameters"
                },
                "on_click": "on_inspect_clicked"
              }
            ]
          },
          {
            "type": "group",
            "props": {
              "title": "Training"
            },
            "children": [
              {
                "type": "spin",
                "name": "epochs",
                "props": {
                  "label": "Epochs",
                  "value": 20,
                  "minimum": 1,
                  "maximum": 500
                }
              },
              {
                "type": "spin",
                "name": "batch",
                "props": {
                  "label": "Batch size",
                  "value": 2,
                  "minimum": 1,
                  "maximum": 32
                }
              },
              {
                "type": "dspin",
                "name": "lr",
                "props": {
                  "label": "Learning rate",
                  "value": 0.001,
                  "minimum": 1e-06,
                  "maximum": 1.0,
                  "step": 0.0001,
                  "decimals": 6
                }
              },
              {
                "type": "spin",
                "name": "img_size",
                "props": {
                  "label": "Image size",
                  "value": 256,
                  "minimum": 64,
                  "maximum": 1024,
                  "step": 32
                }
              },
              {
                "type": "dspin",
                "name": "val_fraction",
                "props": {
                  "label": "Validation fraction",
                  "value": 0.2,
                  "minimum": 0.0,
                  "maximum": 0.6,
                  "step": 0.05,
                  "decimals": 2
                }
              },
              {
                "type": "combo",
                "name": "device",
                "props": {
                  "label": "Device",
                  "items": [
                    "auto",
                    "cpu",
                    "cuda",
                    "mps"
                  ],
                  "current": 0
                }
              },
              {
                "type": "combo",
                "name": "loss",
                "props": {
                  "label": "Loss",
                  "items": [
                    "bce_dice",
                    "dice"
                  ],
                  "current": 0
                }
              },
              {
                "type": "hbox",
                "children": [
                  {
                    "type": "button",
                    "name": "start",
                    "props": {
                      "label": "Start training"
                    },
                    "on_click": "on_start_clicked"
                  },
                  {
                    "type": "button",
                    "name": "stop",
                    "props": {
                      "label": "Stop"
                    },
                    "on_click": "on_stop_clicked"
                  },
                  {
                    "type": "spacer",
                    "props": {
                      "height": 1
                    }
                  }
                ]
              },
              {
                "type": "progress",
                "name": "progress",
                "props": {
                  "minimum": 0,
                  "maximum": 100,
                  "value": 0
                }
              }
            ]
          },
          {
            "type": "group",
            "props": {
              "title": "Predict"
            },
            "children": [
              {
                "type": "file",
                "name": "image_path",
                "props": {
                  "label": "Image",
                  "mode": "open",
                  "filter": "Images (*.png *.jpg *.jpeg *.tif *.tiff *.bmp)"
                }
              },
              {
                "type": "file",
                "name": "weights_path",
                "props": {
                  "label": "Weights",
                  "mode": "open",
                  "filter": "PyTorch (*.pt *.pth)"
                }
              },
              {
                "type": "dspin",
                "name": "threshold",
                "props": {
                  "label": "Threshold",
                  "value": 0.5,
                  "minimum": 0.0,
                  "maximum": 1.0,
                  "step": 0.05,
                  "decimals": 2
                }
              },
              {
                "type": "hbox",
                "children": [
                  {
                    "type": "button",
                    "name": "predict",
                    "props": {
                      "label": "Segment"
                    },
                    "on_click": "on_predict_clicked"
                  },
                  {
                    "type": "button",
                    "name": "save_mask",
                    "props": {
                      "label": "Save mask..."
                    },
                    "on_click": "on_save_mask_clicked"
                  },
                  {
                    "type": "spacer",
                    "props": {
                      "height": 1
                    }
                  }
                ]
              },
              {
                "type": "image",
                "name": "preview",
                "props": {
                  "height": 240
                }
              },
              {
                "type": "label",
                "name": "metrics",
                "props": {
                  "text": "",
                  "wrap": true
                }
              }
            ]
          },
          {
            "type": "group",
            "props": {
              "title": "Export"
            },
            "children": [
              {
                "type": "file",
                "name": "onnx_path",
                "props": {
                  "label": "ONNX output",
                  "mode": "save",
                  "filter": "ONNX (*.onnx)"
                }
              },
              {
                "type": "button",
                "name": "export_onnx",
                "props": {
                  "label": "Export ONNX"
                },
                "on_click": "on_export_clicked"
              }
            ]
          },
          {
            "type": "group",
            "props": {
              "title": "Log"
            },
            "children": [
              {
                "type": "text",
                "name": "log",
                "props": {
                  "text": "",
                  "rows": 8
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
