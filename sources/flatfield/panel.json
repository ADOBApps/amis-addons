{
  "amis_panel": 1,
  "title": "Flat-field threshold",
  "width": 580,
  "height": 680,
  "metadata": {
    "note": "Classical method: runs on one image, no training."
  },
  "root": {
    "type": "vbox",
    "children": [
      {
        "type": "scroll",
        "children": [
          {
            "type": "label",
            "name": "intro",
            "props": {
              "text": "PLACEHOLDER",
              "wrap": true
            }
          },
          {
            "type": "group",
            "props": {
              "title": "Input"
            },
            "children": [
              {
                "type": "file",
                "name": "image_path",
                "props": {
                  "label": "Image",
                  "mode": "open",
                  "filter": "Images (*.png *.jpg *.jpeg *.tif *.tiff *.bmp)"
                }
              }
            ]
          },
          {
            "type": "group",
            "props": {
              "title": "Parameters"
            },
            "children": [
              {
                "type": "dspin",
                "name": "radius_fraction",
                "props": {
                  "label": "Background radius (fraction)",
                  "value": 0.12,
                  "minimum": 0.02,
                  "maximum": 0.4,
                  "step": 0.01,
                  "decimals": 2
                }
              },
              {
                "type": "dspin",
                "name": "bias",
                "props": {
                  "label": "Threshold bias",
                  "value": 1.05,
                  "minimum": 1.0,
                  "maximum": 1.4,
                  "step": 0.01,
                  "decimals": 2
                }
              },
              {
                "type": "check",
                "name": "invert",
                "props": {
                  "text": "Invert (bright object on dark background)",
                  "checked": false
                }
              }
            ]
          },
          {
            "type": "hbox",
            "children": [
              {
                "type": "button",
                "name": "run",
                "props": {
                  "label": "Segment"
                },
                "on_click": "on_run_clicked"
              },
              {
                "type": "button",
                "name": "save_mask",
                "props": {
                  "label": "Save mask..."
                },
                "on_click": "on_save_mask_clicked"
              },
              {
                "type": "spacer",
                "props": {
                  "height": 1
                }
              }
            ]
          },
          {
            "type": "image",
            "name": "preview",
            "props": {
              "height": 260
            }
          },
          {
            "type": "label",
            "name": "metrics",
            "props": {
              "text": "",
              "wrap": true
            }
          },
          {
            "type": "group",
            "props": {
              "title": "Log"
            },
            "children": [
              {
                "type": "text",
                "name": "log",
                "props": {
                  "text": "",
                  "rows": 6
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
